# ── Polymarket CLOB credentials ────────────────────────────────────────────
# Clé privée de ton wallet Polygon (MetaMask → Export private key)
# ⚠️  NE JAMAIS commit ce fichier — garde .env dans .gitignore
POLY_PRIVATE_KEY=0x...

# Adresse du deposit wallet Polymarket
# → polymarket.com/settings → copie l'adresse affichée
DEPOSIT_WALLET_ADDRESS=0x...

# Clés API générées automatiquement via : python setup_auth.py
# (ne pas remplir manuellement)
POLY_API_KEY=
POLY_SECRET=
POLY_PASSPHRASE=

# ── Mode ─────────────────────────────────────────────────────────────────
# paper  → simulation, aucun argent réel
# live   → ordres réels sur Polymarket (USDC sur Polygon requis)
TRADING_MODE=paper

# ── Capital ──────────────────────────────────────────────────────────────
INITIAL_CAPITAL=1000
MAX_POSITION_PCT=0.05     # 5% max par trade
MAX_DAILY_LOSS_PCT=0.10   # kill switch si -10% sur la journée

# ── Stratégie ────────────────────────────────────────────────────────────
MIN_EDGE_PCT=0.08          # edge min 8% pour trader
MIN_LIQUIDITY_USD=500      # liquidité min sur le marché Polymarket
